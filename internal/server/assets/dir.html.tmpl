<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{.Title}}</title><style>{{.CSS}}</style></head><body><main><h1>{{.Title}}</h1>{{if .Description}}<p class="meta">{{.Description}}</p>{{end}}<ul class="files">{{range .Files}}<li><a href="{{.URL}}">{{.Name}}</a><span class="meta">{{.Size}}</span></li>{{end}}</ul></main></body></html>
